{
  "name": "hacker-news-daily",
  "version": "1.0.1",
  "description": "Read Hacker News in your terminal. Top stories, comment trees, keyword filters and JSON or Markdown output.",
  "type": "module",
  "bin": {
    "hn-daily": "dist/cli.js",
    "hnd": "dist/cli.js"
  },
